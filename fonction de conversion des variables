void project_var_conversion(Jeu* jeuA , _jeu* jeuB){ //version de Théo convertie en version d'Assia et de Catherine
    //_____________________________________________________________________________________________________________________
    //player  --  dentiste      ___________________________________________________________________________________________
    jeuA->dentiste.position              = get_player_pos_from_grid(jeuB->grid ,jeuB->grid_size_x ,jeuB->grid_size_y);
    jeuA->dentiste.gants                 = jeuB->player.glove.type == 'h';
    jeuA->dentiste.proprete_gants        = jeuB->player.glove.used;
    if(jeu->.player.tool.type != 0){
        jeuA->dentiste.ustensile_en_main = jeuB->player.tool.type - 'a';  // 0,1,2,3,4,5,6 <- a,b,c,d,e,f,g  
        jeuA->dentiste.main              = 1;
    }
    else{
        jeuA->dentiste.ustensile_en_main = 0;
        jeuA->dentiste.main              = 0;
    }
    jeuA->dentiste.proprete_ustensile    = jeuB->player.tool.used;
    
    //_____________________________________________________________________________________________________________________
    //  Autre                   ___________________________________________________________________________________________
    //jeuA->temps_debut_partie   = (à complété)
    jeuA->nb_client              = (jeuB->hummeur_tab[0]) + (jeuB->hummeur_tab[1]) + (jeuB->hummeur_tab[2]);
    jeuA->argent_cabinet         = jeuB->profit; 
    
    //_____________________________________________________________________________________________________________________
    //patient --  patient       ___________________________________________________________________________________________
    int plate_id = jeuB->plateau_tab[ind_plateau].id - 't';
    for(int ind_plateau = 0;ind_plateau<jeuB->nb_plateau;ind_plateau++){
                 //  0:fauteuil vide ,1:fauteuil non vide
        
        jeuA->patient[plate_id].ustensile = 0;
        for(int i=0;i<NB_TOOLS;i++){
            if(jeuB->plateau_tab[ind_plateau].tools[i]||jeuB->plateau_tab[ind_plateau].used_tools[i]){    //il n'y pas de variable pour différencier un outil propre/sale  ,donc le compteur compte le nombre ustensile présents sale ou pas
                jeuA->patient[plate_id].plateaux[i]  = 1; //    (temporaire)
                //  (à complété)                     = jeuB->plateau_tab[ind_plateau].tools[i]        ;  //pour les ustensile propres
                //  (à complété)                     = jeuB->plateau_tab[ind_plateau].used_tools[i]   ;  //pour les ustensile sale
                jeuA->patient[plate_id].ustensile    ++;
            }
        }
        jeuA->patient[plate_id].fauteuil = jeuB->plateau_tab[ind_plateau].patient!=NULL;
        if(jeuB->plateau_tab[ind_plateau].patient!=NULL){
            jeuA->patient[plate_id].pathologie      = jeuB->plateau_tab[ind_plateau].patient->maladie.type; 
            jeuA->patient[plate_id].montant_a_payer = jeuB->plateau_tab[ind_plateau].patient->maladie.profit; //(à modifier) reste à modifier la quantité en fonction de l'état du patient
            //jeuA->patient.heure_arrive            = (à complété)
            //jeuA->patient.etat                    = (à complété)
            /*----------------------------------
                serait mieux si le variable hummeur du structure patient (celui d'Assia et de Catherine) est un int sinon lors d'un sauvegarde du jeu puis chargement du jeu la bar de 
                jauge peut etre chargé uniquement trois état que plusieurs int donc la précision est perdu de plus les joueurs pourront abusé ce system de sauvegardepour sauvé la 
                partie quand ils vont perdre
            */
            //---------(temporaire)-------------
            if(jeuB->plateau_tab[ind_plateau].patient->hummeur > 0.45*(game.patient_spawning_hapiness+game.patient_hapiness_range)  ){
                jeuA->patient.hummeur    = VERT;
            }
            else if(jeuB->plateau_tab[ind_plateau].patient->hummeur > 0.22*(game.patient_spawning_hapiness+game.patient_hapiness_range)  ){
                jeuA->patient.hummeur    = ORANGE;
            }
            else{
                jeuA->patient.hummeur    = ROUGE;
            }
        }
    }
    //_____________________________________________________________________________________________________________________
    //_____________________________________________________________________________________________________________________
}
